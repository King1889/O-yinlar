}


/* =====================================================
               PICKUP SPAWNING SYSTEM
===================================================== */

function spawnFirstPickups(){

  pickups=[];

  spawnOnePickup();
  spawnOnePickup();

}


function spawnOnePickup(){

  const available=
    platforms.filter(
      p=>p.y<700 && p.w>=110
    );

  if(available.length===0)
    return;

  const plat=
    available[
      Math.floor(
        Math.random()*available.length
      )
    ];

  const weapon=
    Math.floor(
      Math.random()*weapons.length
    );

  pickups.push({

    x:plat.x+plat.w/2-25,

    y:plat.y-48,

    w:50,
    h:42,

    weapon:weapon,

    life:1000

  });

}


function updatePickups(){

  pickupSpawnTimer++;


  /* sekin spawn */

  if(
    pickupSpawnTimer>
    pickupSpawnDelay
  ){

    if(pickups.length<5){

      spawnOnePickup();

    }

    pickupSpawnTimer=0;

    pickupSpawnDelay=
      650+
      Math.random()*750;

  }


  for(let i=pickups.length-1;i>=0;i--){

    const item=pickups[i];

    item.life--;


    if(item.life<=0){

      pickups.splice(i,1);

      continue;

    }


    if(playerTouchesPickup(p1,item)){

      collectWeapon(
        p1,
        item.weapon
      );

      pickups.splice(i,1);

      continue;

    }


    if(playerTouchesPickup(p2,item)){

      collectWeapon(
        p2,
        item.weapon
      );

      pickups.splice(i,1);

      continue;

    }

  }

}


function playerTouchesPickup(p,item){

  return(

    p.x<item.x+item.w &&
    p.x+p.w>item.x &&
    p.y<item.y+item.h &&
    p.y+p.h>item.y

  );

}


/* =====================================================
