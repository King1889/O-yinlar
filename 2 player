    });

  }

}


/* =====================================================
                  PLAYER UPDATE
===================================================== */

function updatePlayer(p,enemy){

  if(gameOver)
    return;


  /* MOVEMENT */

  if(keys[p.controls.left]){

    p.vx=-p.speed;
    p.facing=-1;

  }

  else if(keys[p.controls.right]){

    p.vx=p.speed;
    p.facing=1;

  }

  else{

    p.vx*=.78;

  }


  /* DOUBLE JUMP */

  if(
    keys[p.controls.jump] &&
    !p.jumpPressed
  ){

    if(p.grounded){

      p.vy=-p.jump;

      p.grounded=false;

      p.jumps=1;

    }

    else if(
      p.jumps<p.maxJumps
    ){

      p.vy=-p.jump;

      p.jumps++;

    }

    p.jumpPressed=true;

  }


  if(!keys[p.controls.jump])
    p.jumpPressed=false;


  p.vy+=.62;

  p.x+=p.vx;


  if(p.x<0){

    p.x=0;
    p.vx=0;

  }


  if(p.x+p.w>W){

    p.x=W-p.w;
    p.vx=0;

  }


  const oldBottom=
    p.y+p.h;

  p.y+=p.vy;

  p.grounded=false;


  /* PLATFORM COLLISION */

  for(const plat of platforms){

    if(

      oldBottom<=plat.y &&

      p.y+p.h>=plat.y &&

      p.x+p.w>plat.x &&

      p.x<plat.x+plat.w &&

      p.vy>=0

    ){

      p.y=plat.y-p.h;

      p.vy=0;

      p.grounded=true;

      p.jumps=0;

    }

  }


  if(p.y>H+100){

    p.hp=0;

    endRound(enemy);

  }


  if(p.cooldown>0)
    p.cooldown--;


  /* SHOOT */

  if(
    keys[p.controls.shoot] &&
    p.cooldown<=0 &&
    p.weapon!==-1 &&
    p.ammo>0
  ){

    shoot(p);

    p.ammo--;

    p.cooldown=
      weapons[p.weapon].cooldown;


    if(p.ammo<=0){

      texts.push({

        x:p.x+p.w/2,

        y:p.y-25,

        text:"AMMO TUGADI",

        life:100,

        big:false

      });

      /* qo'l bo'sh */

      p.weapon=-1;
      p.ammo=0;

    }

  }

}


/* =====================================================
                        SHOOT
===================================================== */

function shoot(p){

  if(p.weapon===-1)
    return;

  const weapon=
    weapons[p.weapon];


  for(
    let i=0;
    i<weapon.count;
    i++
  ){

    const base=
      p.facing<0?
      Math.PI:
      0;

    const spread=
      (Math.random()-.5)*
      weapon.spread;

    const angle=
      base+spread;


    bullets.push({

      x:
        p.x+
        p.w/2+
        p.facing*28,

      y:
        p.y+24,

      vx:
        Math.cos(angle)*
        weapon.speed,

      vy:
        Math.sin(angle)*
        weapon.speed,

      owner:p,

      damage:weapon.damage,

      color:weapon.color,

      size:weapon.size,

      life:100

    });

  }

}


/* =====================================================
                     BULLETS
===================================================== */

function updateBullets(){

  for(
    let i=bullets.length-1;
    i>=0;
    i--
  ){

    const b=bullets[i];

    b.x+=b.vx;
    b.y+=b.vy;

    b.life--;


    const enemy=
      b.owner===p1?
      p2:
      p1;

    let remove=false;


    /* PLATFORM */

    for(const plat of platforms){

      if(

        b.x>plat.x &&
        b.x<plat.x+plat.w &&
        b.y>plat.y &&
        b.y<plat.y+plat.h

      ){

        remove=true;

        createHitParticles(
          b.x,
          b.y,
          b.color
        );

        break;

      }

    }


    /* PLAYER */

    if(
      !remove &&
      hitTest(b,enemy)
    ){

      enemy.hp-=b.damage;

      createHitParticles(
        b.x,
        b.y,
        b.color
      );

      remove=true;


      if(enemy.hp<=0){

        endRound(
          b.owner
        );

      }

    }


    if(

      b.x<-50 ||
      b.x>W+50 ||
      b.y<-50 ||
      b.y>H+50 ||
      b.life<=0

    ){

      remove=true;

    }


    if(remove)
      bullets.splice(i,1);

  }

}


function hitTest(b,p){

  return(

    b.x>p.x-5 &&
    b.x<p.x+p.w+5 &&
    b.y>p.y-5 &&
    b.y<p.y+p.h+5

  );

}


/* =====================================================
                     END ROUND
===================================================== */

function endRound(w){

  if(gameOver)
    return;

  gameOver=true;

  winner=w;


  if(w===p1)
    kills1++;
  else
    kills2++;


  texts.push({

    x:W/2,

    y:240,

    text:"+1 KILL",

    life:100,

    big:true

  });


  for(let i=0;i<50;i++){

    particles.push({

      x:w.x+w.w/2,

      y:w.y+20,

      vx:(Math.random()-.5)*11,

      vy:(Math.random()-.5)*11,

      life:40+Math.random()*60,

      size:3+Math.random()*5,

      color:w.color

    });

  }

}


/* =====================================================
                     PARTICLES
===================================================== */

function createHitParticles(
  x,
  y,
  color
){

  for(let i=0;i<10;i++){

    particles.push({

      x:x,
      y:y,

      vx:(Math.random()-.5)*8,

      vy:(Math.random()-.5)*8,

      life:20+Math.random()*25,

      size:2+Math.random()*4,

      color:color

    });

  }

}


function updateParticles(){

  for(
    let i=particles.length-1;
    i>=0;
    i--
  ){

    const p=particles[i];

    p.x+=p.vx;
    p.y+=p.vy;

    p.vy+=.12;

    p.life--;


    if(p.life<=0)
      particles.splice(i,1);

  }

}


/* =====================================================
                        TEXTS
===================================================== */

function updateTexts(){

  for(
    let i=texts.length-1;
    i>=0;
    i--
  ){

    const t=texts[i];

    t.y-=1;

    t.life--;


    if(t.life<=0)
      texts.splice(i,1);

  }

}


/* =====================================================
                    BACKGROUND
===================================================== */

function drawBackground(){

  const z=zones[zone];


  const g=
    ctx.createLinearGradient(
      0,0,0,H
    );

  g.addColorStop(0,z.sky1);
  g.addColorStop(1,z.sky2);


  ctx.fillStyle=g;

  ctx.fillRect(
    0,0,W,H
  );


  if(zone===5){

    drawSpace();

  }

  else{

    ctx.fillStyle="#ffe477";

    ctx.beginPath();

    ctx.arc(
      1350,
      120,
      55,
      0,
      Math.PI*2
    );

    ctx.fill();


    cloud(180,120,1);
    cloud(700,90,.8);
    cloud(1050,170,.7);

  }


  if(zone===0)
    drawMountains();

  if(zone===1)
    drawCity();

  if(zone===2)
    drawFactory();

  if(zone===3)
    drawDesert();

  if(zone===4)
    drawIce();

  if(zone===6)
    drawRooftops();

  if(zone===7)
    drawVolcano();

}


/* =====================================================
                       CLOUD
===================================================== */

function cloud(x,y,s){

  ctx.save();

  ctx.translate(x,y);

  ctx.scale(s,s);

  ctx.fillStyle=
    "rgba(255,255,255,.7)";

  ctx.beginPath();

  ctx.arc(0,10,28,0,Math.PI*2);
