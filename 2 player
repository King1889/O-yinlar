/* =====================================================
                   REALISTIC GAME GUN
===================================================== */

function drawGunShape(
  weapon,
  x,
  y,
  scale
){

  ctx.save();

  ctx.translate(x,y);

  ctx.scale(scale,scale);

  ctx.fillStyle="#171a20";


  if(weapon.type==="pistol"){

    ctx.fillRect(
      -17,
      -5,
      30,
      8
    );

    ctx.fillRect(
      5,
      3,
      7,
      13
    );

    ctx.fillRect(
      -4,
      3,
      10,
      5
    );

    ctx.fillStyle="#555";

    ctx.fillRect(
      8,
      -4,
      8,
      3
    );

  }


  else if(
    weapon.type==="smg"
  ){

    ctx.fillRect(
      -24,
      -5,
      43,
      8
    );

    ctx.fillRect(
      12,
      3,
      9,
      11
    );

    ctx.fillRect(
      -7,
      3,
      7,
      12
    );

    ctx.fillStyle="#444";

    ctx.fillRect(
      -17,
      -9,
      22,
      4
    );

  }


  else if(
    weapon.type==="shotgun"
  ){

    ctx.fillRect(
      -25,
      -6,
      50,
      7
    );

    ctx.fillRect(
      15,
      1,
      9,
      12
    );

    ctx.fillStyle="#5b3b24";

    ctx.fillRect(
      -5,
      1,
      18,
      7
    );

    ctx.fillStyle="#777";

    ctx.fillRect(
      -25,
      -9,
      35,
      3
    );

  }


  else if(
    weapon.type==="laser"
  ){

    ctx.fillRect(
      -23,
      -5,
      45,
      8
    );

    ctx.fillRect(
      -5,
      3,
      8,
      11
    );

    ctx.fillStyle=
      weapon.color;

    ctx.fillRect(
      15,
      -4,
      10,
      4
    );

  }


  else if(
    weapon.type==="plasma"
  ){

    ctx.fillRect(
      -22,
      -6,
      42,
      11
    );

    ctx.fillRect(
      -5,
      5,
      9,
      12
    );

    ctx.fillStyle=
      weapon.color;

    ctx.beginPath();

    ctx.arc(
      20,
      0,
      6,
      0,
      Math.PI*2
    );

    ctx.fill();

  }


  else if(
    weapon.type==="heavy"
  ){

    ctx.fillRect(
      -27,
      -8,
      55,
      13
    );

    ctx.fillRect(
      -3,
      5,
      11,
      14
    );

    ctx.fillStyle="#555";

    ctx.fillRect(
      -22,
      -12,
      30,
      4
    );

  }


  ctx.restore();

}


/* =====================================================
                       PLAYER
===================================================== */

function drawPlayer(p){

  ctx.save();


  ctx.translate(
    p.x+p.w/2,
    p.y+p.h/2
  );


  if(p.facing<0)
    ctx.scale(-1,1);


  /* SHADOW */

  ctx.fillStyle=
    "rgba(0,0,0,.25)";

  ctx.beginPath();

  ctx.ellipse(
    0,
    34,
    28,
    7,
    0,
    0,
    Math.PI*2
  );

  ctx.fill();


  /* LEGS */

  ctx.fillStyle="#20242b";

  ctx.fillRect(
    -13,
    18,
    10,
    23
  );

  ctx.fillRect(
    4,
    18,
    10,
    23
  );


  /* BODY */

  ctx.fillStyle=p.color;

  ctx.fillRect(
    -19,
    -15,
    38,
    37
  );


  /* HEAD */

  ctx.fillStyle="#ffd0a6";

  ctx.beginPath();

  ctx.arc(
    0,
    -30,
    16,
    0,
    Math.PI*2
  );

  ctx.fill();


  /* HELMET */

  ctx.fillStyle=
    p.type===1?
    "#dce9ff":
    "#191919";

  ctx.beginPath();

  ctx.arc(
    0,
    -32,
    19,
    Math.PI,
    Math.PI*2
  );

  ctx.fill();


  ctx.fillStyle=
    p.type===1?
    "#67c8ff":
    "#111";

  ctx.fillRect(
    -14,
    -31,
    28,
    8
  );


  /* EYE */

  ctx.fillStyle="#111";

  ctx.fillRect(
    5,
    -31,
    3,
    3
  );


  /* GUN */

  if(p.weapon!==-1){

    ctx.save();

    ctx.translate(
      22,
      -5
    );

    drawGunShape(
      weapons[p.weapon],
      0,
      0,
      .72
    );

    ctx.restore();

  }

  else{

    /* EMPTY HAND */

    ctx.fillStyle="#ffd0a6";

    ctx.beginPath();

    ctx.arc(
      22,
      -1,
      6,
      0,
      Math.PI*2
    );

    ctx.fill();

  }


  ctx.restore();


  /* NAME */

  ctx.textAlign="center";

  ctx.font="bold 12px Arial";

  ctx.fillStyle="#fff";

  ctx.fillText(
    p.name,
    p.x+p.w/2,
    p.y-8
  );

}


/* =====================================================
                       BULLETS
===================================================== */

function drawBullets(){

  for(const b of bullets){

    ctx.fillStyle=b.color;

    ctx.shadowBlur=14;

    ctx.shadowColor=b.color;


    ctx.beginPath();

    ctx.arc(
      b.x,
      b.y,
      b.size,
      0,
      Math.PI*2
    );

    ctx.fill();


    ctx.shadowBlur=0;

  }

}


/* =====================================================
                      PARTICLES
===================================================== */

function drawParticles(){

  for(const p of particles){

    ctx.globalAlpha=
      Math.max(
        0,
        p.life/60
      );

    ctx.fillStyle=p.color;

    ctx.fillRect(
      p.x,
      p.y,
      p.size,
      p.size
    );

  }

  ctx.globalAlpha=1;

}


/* =====================================================
                        TEXT
===================================================== */

function drawTexts(){

  for(const t of texts){

    ctx.globalAlpha=
      Math.max(
        0,
        t.life/100
      );

    ctx.textAlign="center";

    ctx.font=
      t.big?
      "bold 54px Arial":
      "bold 20px Arial";

    ctx.fillStyle="#fff";

    ctx.strokeStyle="#000";

    ctx.lineWidth=6;


    ctx.strokeText(
      t.text,
      t.x,
      t.y
    );


    ctx.fillText(
      t.text,
      t.x,
      t.y
    );

  }

  ctx.globalAlpha=1;

}


/* =====================================================
                       HP BAR
===================================================== */

function hpBar(
  p,
  x,
  y,
  w
){

  ctx.fillStyle=
    "rgba(0,0,0,.55)";

  ctx.fillRect(
    x,
    y,
    w,
    18
  );


  const hp=
    Math.max(
      0,
      p.hp/p.maxHp
    );


  ctx.fillStyle=p.color;

  ctx.fillRect(
    x,
    y,
    w*hp,
    18
  );


  ctx.strokeStyle="#fff";

  ctx.strokeRect(
    x,
    y,
    w,
    18
  );

}


