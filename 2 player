===================================================== */

function switchWeapon(p,direction){

  if(weapons.length===0)
    return;

  if(p.weapon===-1){

    p.weapon=
      direction>0?
      0:
      weapons.length-1;

    p.ammo=weapons[p.weapon].maxAmmo;

    showWeaponText(p);

    return;
  }

  p.weapon=
    (p.weapon+direction+weapons.length)
    %weapons.length;

  p.ammo=weapons[p.weapon].maxAmmo;

  showWeaponText(p);

}


function showWeaponText(p){

  texts.push({

